{
  "expo": {
    "name": "DigiLocal Vendor",
    "slug": "digi-local_vendor",
    "scheme": "digilocalvendor",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F6F0"
    },
    "android": {
      "package": "com.digilocal.vendor",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "@react-native-firebase/app",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-av",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#541D26",
          "sounds": [
            "./assets/order_alert_chime.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DigiLocal Vendor to access your photos to upload store logo, shop images, and product photos.",
          "cameraPermission": "Allow DigiLocal Vendor to access your camera to take store and product photos."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "colorPrimary": "#541D26",
            "colorAccent": "#C8A878",
            "colorPrimaryDark": "#3D1219"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow DigiLocal Vendor to access your microphone to record speech.",
          "speechRecognitionPermission": "Allow DigiLocal Vendor to use speech recognition."
        }
      ],
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc89e8e6-ba8a-47fd-ae6a-6576e18da293"
      }
    },
    "owner": "lovelyjain24",
    "ios": {
      "bundleIdentifier": "com.digilocal.vendor",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition to convert your voice to text.",
        "NSMicrophoneUsageDescription": "This app needs access to the microphone to capture your speech.",
        "NSCameraUsageDescription": "This app needs access to your camera to take photos of your store and products.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select and upload store logo and product images."
      }
    }
  }
}
