{
  "expo": {
    "name": "DigiLocal Vendor",
    "slug": "digi-local_vendor",
    "scheme": "digilocalvendor",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "com.digilocal.vendor",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#541D26",
          "sounds": [
            "./assets/order_alert_chime.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DigiLocal Vendor to access your photos to upload store logo, shop images, and product photos.",
          "cameraPermission": "Allow DigiLocal Vendor to access your camera to take store and product photos."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "colorPrimary": "#541D26",
            "colorAccent": "#C8A878",
            "colorPrimaryDark": "#3D1219"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F6F0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc89e8e6-ba8a-47fd-ae6a-6576e18da293"
      }
    },
    "owner": "lovelyjain24",
    "ios": {
      "bundleIdentifier": "com.digilocal.vendor",
      "buildNumber": "3",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "DigiLocal Vendor",
        "NSCameraUsageDescription": "Allow DigiLocal Vendor to access your camera to take store, shop image, and product photos.",
        "NSPhotoLibraryUsageDescription": "Allow DigiLocal Vendor to access your photo library to select and upload shop images and product photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow DigiLocal Vendor to save photos to your photo library.",
        "NSMicrophoneUsageDescription": "Allow DigiLocal Vendor to access your microphone for voice-based search.",
        "NSLocationWhenInUseUsageDescription": "Allow DigiLocal Vendor to access your location to discover nearby societies and service areas."
      }
    }
  }
}
