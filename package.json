    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "JAVA_HOME=/opt/homebrew/opt/openjdk@17 expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');try{const src=path.join(__dirname,'node_modules/hermes-compiler/hermesc'),dest=path.join(__dirname,'node_modules/react-native/sdks/hermesc');if(fs.existsSync(src)&&!fs.existsSync(dest)){fs.mkdirSync(path.dirname(dest),{recursive:true});fs.cpSync(src,dest,{recursive:true});console.log('[postinstall] Linked hermesc to react-native/sdks');}}catch(e){}\"",
    "build:apk": "eas build -p android --profile preview",
    "build:aab": "eas build -p android --profile production"
  },
  "private": true,
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "dtrace-provider@0.8.8": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true
  }
