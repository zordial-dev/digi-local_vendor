# Exclude large directories and build caches from EAS upload
node_modules/
.expo/
dist/
web-build/
*.log
.DS_Store
Thumbs.db
frontend/
docs/

# iOS native build outputs & pods
ios/build/
ios/Pods/
ios/build.log
ios/*.xcworkspace/xcuserdata
ios/*.xcodeproj/xcuserdata
ios/*.xcodeproj/project.xcworkspace/xcuserdata

# Android native build outputs
android/build/
android/.gradle/
android/app/build/
android/.idea/
android/app/build/intermediates/
android/app/.cxx/
android/.cxx/
.gradle/

# Exclude binaries and archive files
*.apk
*.aab
*.ipa
*.tar.gz
*.zip
app-release.apk

# Keep configuration files
!google-services.json
!GoogleService-Info.plist
