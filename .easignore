# Exclude large directories and build caches from EAS upload
node_modules/
.expo/
dist/
web-build/
*.log
.DS_Store
Thumbs.db
frontend/

# Exclude Android native build outputs
android/build/
android/.gradle/
android/app/build/
android/.idea/
android/app/build/intermediates/
android/app/.cxx/
android/.cxx/
.gradle/

# Exclude binaries and archive files
*.apk
*.aab
*.ipa
app-release.apk

# Keep google-services.json for Firebase FCM
!google-services.json
!GoogleService-Info.plist
