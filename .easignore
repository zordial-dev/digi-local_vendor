# Exclude large directories and build caches from EAS upload
node_modules/
.expo/
dist/
web-build/
*.log
.DS_Store
Thumbs.db

# Exclude Android native build outputs
android/build/
android/.gradle/
android/app/build/
android/.idea/
android/app/build/intermediates/

# Keep google-services.json for Firebase FCM
!google-services.json
!GoogleService-Info.plist
